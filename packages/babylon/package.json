{
  "name": "@insimul/babylon",
  "version": "0.2.0",
  "description": "The consolidated Babylon.js runtime for Insimul — one package per web engine. Conversation SDK, save/data/loading layer, the Babylon engine, and game-export templates. Install this one package to plug Insimul into a web game.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./conversation": {
      "import": "./src/conversation/index.ts",
      "types": "./src/conversation/index.ts"
    },
    "./conversation/*": {
      "import": "./src/conversation/*",
      "types": "./src/conversation/*"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insimul/runtime.git",
    "directory": "packages/babylon"
  },
  "homepage": "https://github.com/insimul/runtime/tree/main/packages/babylon",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "templates",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "insimul",
    "babylon",
    "npc",
    "conversation",
    "ai",
    "game",
    "save-file",
    "web"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.82"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": { "optional": true }
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "^0.2.82",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
