{
  "name": "@insimul/typescript",
  "version": "0.1.1",
  "description": "DEPRECATED passthrough — the conversation SDK moved to @insimul/babylon/conversation. This package re-exports it unchanged so existing installs keep working. New code should import from @insimul/babylon.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insimul/runtime.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://github.com/insimul/runtime/tree/main/packages/typescript",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "insimul",
    "npc",
    "conversation",
    "ai",
    "game",
    "streaming",
    "tts",
    "stt",
    "lip-sync"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mlc-ai/web-llm": "^0.2.82"
  },
  "peerDependenciesMeta": {
    "@mlc-ai/web-llm": { "optional": true }
  },
  "devDependencies": {
    "@mlc-ai/web-llm": "^0.2.82",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
