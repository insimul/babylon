{
  "fileName": "romance.json",
  "category": "romance",
  "rules": [
    {
      "name": "Flirt Back",
      "title": "Return a recent flirtation",
      "type": "volition",
      "likelihood": 0.65,
      "conditions": [
        { "category": "directed status", "type": "attracted", "first": "responder", "second": "initiator" },
        { "category": "event", "type": "flirted", "first": "initiator", "second": "responder", "turnsAgoBetween": [0, 3] }
      ],
      "effects": [
        { "category": "intent", "type": "flirt", "first": "initiator", "second": "responder", "weight": 3 }
      ]
    },
    {
      "name": "Jealous Of Rival",
      "title": "Grow jealous when a rival courts your love",
      "conditions": [
        { "category": "directed_status", "type": "loves", "first": "initiator", "second": "responder" },
        { "category": "event undirected", "type": "courted", "first": "third", "second": "responder" }
      ],
      "effects": [
        { "category": "directed status", "type": "jealous", "first": "initiator", "second": "third" },
        { "category": "mood", "type": "angry", "first": "initiator" }
      ]
    },
    {
      "name": "Trigger Heartbreak",
      "title": "Heartbreak on betrayal (state-change trigger rule)",
      "type": "trigger",
      "conditions": [
        { "category": "directed status", "type": "loves", "first": "initiator", "second": "responder" },
        { "category": "event", "type": "betrayed", "first": "responder", "second": "initiator" }
      ],
      "effects": [
        { "category": "directed status", "type": "loves", "first": "initiator", "second": "responder", "value": false },
        { "category": "status", "type": "heartbroken", "first": "initiator" }
      ]
    }
  ]
}
