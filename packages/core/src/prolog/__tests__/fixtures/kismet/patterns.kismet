# Kismet pattern-dialect corpus (US-PC3 mass-conversion fixture).
# Pattern rules chain infix relationship / directed-status verbs across several
# actors — the social-graph patterns Kismet is built around.

pattern rule love_triangle_breeds_jealousy {
  category: romance
  priority: 8
  likelihood: 0.5
  when:
    ?x loves ?y
    ?y loves ?z
    not ?y loves ?x
  then:
    ?x jealous_of ?z
}

pattern rule mutual_friends_bond {
  category: friendship
  when:
    ?x friends ?mutual
    ?y friends ?mutual
    not ?x friends ?y
  then:
    ?x likes ?y
}

pattern rule enemy_of_friend {
  category: social
  priority: 6
  when:
    ?x friends ?y
    ?z hates ?y
  then:
    ?x distrusts ?z
    not ?x likes ?z
}

pattern rule spurned_lover_feuds {
  category: romance
  when:
    ?x loves ?y
    ?y dating ?rival
  then:
    ?x hates ?rival
}
