# Kismet volition-dialect corpus (US-PC3 mass-conversion fixture).
# Volition rules produce weighted intents (desires) rather than mutating state.

volition rule flirt_with_crush {
  category: romance
  priority: 5
  likelihood: 0.8
  when:
    ?x dstatus attracted_to ?y
    ?x not trait shy
  then:
    ?x wants flirt ?y weight 3
}

volition rule confront_rival {
  category: conflict
  priority: 6
  when:
    ?x dstatus jealous_of ?y
    ?x trait bold
  then:
    ?x wants confront ?y weight 4
}

volition rule seek_comfort {
  category: social
  when:
    ?x mood lonely
  then:
    ?x wants socialize weight 2
}

volition rule brag_when_proud {
  category: social
  likelihood: 0.4
  when:
    ?x mood proud
    ?x attr confidence >= 5
  then:
    ?x wants boast weight 1
}
