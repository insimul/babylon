# ToTT Python-class corpus (US-PC4 mass-conversion fixture).
# Hand-authored in-repo — the platform client's unified-syntax ToTT test data is
# not checked out in this worktree. Exercises the Python-class source shape and
# every condition/effect form the parser supports.

class ExtrovertSeeksCompany(VolitionRule):
    category = "social"
    priority = 6
    likelihood = 0.7
    def when(self):
        x.extroversion > 0.6
        x.lonely
    def then(self):
        x.wants("socialize")

class RivalsGrowDistant(TriggerRule):
    category = "conflict"
    priority = 7
    def when(self):
        x.charge(y) < 0.2
        x.dislikes(y)
    def then(self):
        x.charge(y) -= 0.1
        x.resents(y) = True

class ConscientiousStaysContent(TriggerRule):
    category = "employment"
    def when(self):
        x.conscientiousness >= 0.6
        x.employed
    def then(self):
        x.set_mood("content")
        x.confidence += 1

class FriendsReinforceBond(TriggerRule):
    category = "friendship"
    def when(self):
        x.friends(y)
        not x.resents(y)
    def then(self):
        x.salience(y) += 0.1
        x.add_trait("loyal")
