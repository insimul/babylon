{
  "name": "@insimul/core",
  "version": "0.1.0",
  "description": "Engine-agnostic Insimul contract — save-file format, world types, and (incrementally) the Prolog toolchain, IR, and quest/data-source types. No Babylon.js, React, or DOM dependencies, so native engine plugins (Unreal/Unity/Godot) can consume the contract directly.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insimul/runtime.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/insimul/runtime/tree/main/packages/core",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "insimul",
    "save-file",
    "contract",
    "engine-agnostic"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
