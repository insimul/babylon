{
  "$ref": "#/definitions/SaveFileEnvelope",
  "definitions": {
    "SaveFileEnvelope": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "insimul-save-v2"
        },
        "exportedAt": {
          "type": "string"
        },
        "insimulVersion": {
          "type": "string"
        },
        "saveFile": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "slotIndex": {
              "type": "integer"
            },
            "userId": {
              "type": "string"
            },
            "worldId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "completed",
                "abandoned"
              ]
            },
            "createdAt": {
              "type": "string"
            },
            "lastSavedAt": {
              "type": "string"
            },
            "totalPlaytime": {
              "type": "number"
            },
            "saveCount": {
              "type": "integer"
            },
            "worldSnapshot": {
              "type": "object",
              "properties": {
                "world": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ],
                  "additionalProperties": true
                },
                "countries": {
                  "type": "array",
                  "items": {}
                },
                "settlements": {
                  "type": "array",
                  "items": {}
                },
                "characters": {
                  "type": "array",
                  "items": {}
                },
                "lots": {
                  "type": "array",
                  "items": {}
                },
                "quests": {
                  "type": "array",
                  "items": {}
                },
                "rules": {
                  "type": "array",
                  "items": {}
                },
                "actions": {
                  "type": "array",
                  "items": {}
                },
                "grammars": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "world"
              ],
              "additionalProperties": true
            },
            "currentState": {
              "type": "object",
              "properties": {
                "player": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "quests": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "npcs": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "languageProgress": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "prologFacts": {
                  "type": "array",
                  "items": {}
                },
                "extensions": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "player",
                "quests",
                "npcs",
                "languageProgress",
                "prologFacts",
                "extensions"
              ],
              "additionalProperties": true
            },
            "conversations": {
              "type": "array",
              "items": {}
            },
            "previousSnapshots": {
              "type": "array",
              "items": {}
            }
          },
          "required": [
            "id",
            "slotIndex",
            "userId",
            "worldId",
            "name",
            "version",
            "status",
            "createdAt",
            "lastSavedAt",
            "totalPlaytime",
            "saveCount",
            "worldSnapshot",
            "currentState",
            "conversations"
          ],
          "additionalProperties": true
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "format",
        "exportedAt",
        "insimulVersion",
        "saveFile",
        "integrity"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
