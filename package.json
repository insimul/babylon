{
  "name": "@insimul/runtime",
  "version": "0.1.1",
  "description": "Insimul runtime SDK — shared engine, prolog runtime, save-file format, language tracking, game-engine UI/rendering, and game-export templates that ship inside games built with the Insimul platform.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insimul/runtime.git"
  },
  "homepage": "https://github.com/insimul/runtime",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "shared",
    "packages/godot/templates",
    "packages/unity/templates",
    "packages/unreal/templates"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "engines:manifests": "node scripts/engines/validate-manifests.mjs",
    "test": "vitest run",
    "test:export-shell": "npm --workspace=@insimul/babylon run test:export-shell"
  },
  "dependencies": {
    "@sentry/react": "^10.48.0",
    "tau-prolog": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
