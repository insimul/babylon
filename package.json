{
  "name": "@insimul/runtime",
  "version": "0.1.1",
  "description": "Insimul runtime SDK — shared engine, prolog runtime, save-file format, language tracking, game-engine UI/rendering, and game-export templates that ship inside games built with the Insimul platform.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insimul/runtime.git"
  },
  "homepage": "https://github.com/insimul/runtime",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "shared",
    "packages/godot/templates",
    "packages/unity/templates",
    "packages/unreal/templates"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.check.json",
    "engines:manifests": "node scripts/engines/validate-manifests.mjs",
    "engines:templates": "node scripts/engines/validate-templates.mjs",
    "engines:check": "bash scripts/engines-check.sh",
    "engines:unreal:host": "bash tools/verify-unreal/run-host-tests.sh",
    "engines:release": "node scripts/engines/release-dry-run.mjs",
    "test": "vitest run",
    "test:export-shell": "npm --workspace=@insimul/babylon run test:export-shell",
    "codegen": "node tools/codegen/index.mjs",
    "codegen:verify-cs": "node tools/codegen/verify-cs/run.mjs",
    "codegen:verify-cpp": "node tools/codegen/verify-cpp/run.mjs",
    "codegen:verify-gdscript": "node tools/codegen/verify-gdscript/run.mjs",
    "openapi:sync": "node tools/codegen/openapi-sync.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.48.0",
    "tau-prolog": "^0.3.4",
    "@babylonjs/core": "^8.54.1",
    "@babylonjs/gui": "^8.54.1",
    "@babylonjs/inspector": "^8.56.1",
    "@babylonjs/loaders": "^8.54.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "quicktype": "25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  }
}
