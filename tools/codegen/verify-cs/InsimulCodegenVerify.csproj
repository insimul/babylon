<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure-DTO compile check for the generated C# (codegen-pipeline US-CG1).
    net8.0, NO Unity dependency: System.Text.Json ships in the framework, so this
    proves the generated DTOs compile on a stock .NET SDK. Run via `npm run codegen:verify-cs`.

    It compiles ONLY the generated Insimul.Generated sources (explicit include below)
    plus this project's own Program.cs — never the Unity-runtime *.cs that reference
    UnityEngine.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Don't auto-glob; we include sources explicitly so no stray file compiles. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>InsimulCodegenVerify</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- All committed generated DTOs (US-CG1 C#; US-CG4 will add Generated/Api/*.cs). -->
    <Compile Include="../../../packages/unity/Runtime/Generated/**/*.cs" />
  </ItemGroup>

</Project>
