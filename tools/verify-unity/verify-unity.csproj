<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free net8 console harness for the Unity Prolog wrapper.

    It compiles the pure C# under packages/unity/Runtime/Prolog/ (which has NO
    UnityEngine references, by design) directly via <Compile Include> and
    exercises it against a locally built libinsimul dylib. This lets US-UP1/2/3
    logic be verified on a plain .NET SDK machine with NO Unity editor present
    (autoMerge is off; Unity-specific glue is human-verified separately).

    Run with tools/verify-unity/run.sh, which builds libinsimul first and puts
    the dylib on the loader path.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>verify-unity</AssemblyName>
    <RootNamespace>Insimul.Verify</RootNamespace>
    <!-- Keep the runtime source as the single source of truth — do not copy. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The shared, framework-agnostic conformance runner (US-UP2), referenced in
         place from the Unity EditMode test folder. The NUnit wrapper beside it
         (ConformanceCorpusTests.cs) is deliberately NOT included here so this
         harness never needs nunit.framework. -->
    <Compile Include="../../packages/unity/Tests/Editor/ConformanceCorpus.cs" />
    <!-- World loading core (US-UC1): engine-agnostic, UnityEngine-free. It parses
         through the generated schema DTOs (InsimulGenerated.cs) via System.Text.Json,
         so both are compiled here. Its shared fixture locator + the console tests in
         Program.cs drive it against the golden saves. The StreamingAssets adapter is
         UnityEngine-coupled and thus deliberately NOT included (structural gate only). -->
    <Compile Include="../../packages/unity/Runtime/World/InsimulWorldSource.cs" />
    <Compile Include="../../packages/unity/Runtime/Generated/InsimulGenerated.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/WorldSourceCorpus.cs" />
    <!-- Portable save system (US-UC2): engine-agnostic, UnityEngine-free. The
         mutable JSON model + canonical-JSON/SHA-256 core + migration chain. Its
         shared fixture locator + the console tests in Program.cs drive it against
         the golden saves + the TS-migration goldens. The StreamingAssets slot
         adapter is UnityEngine-coupled and thus NOT included (structural gate only). -->
    <Compile Include="../../packages/unity/Runtime/Save/JsonVal.cs" />
    <Compile Include="../../packages/unity/Runtime/Save/InsimulSaveSystem.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/SaveSystemCorpus.cs" />
    <!-- Quest system (US-UC3): engine-agnostic, UnityEngine-free. The portable
         hydration + query-driven completion core over currentState.prologFacts,
         plus the stateful shell preserving the template QuestSystem events. The
         golden hydration corpus (packages/core/conformance/quests) + the console
         tests in Program.cs drive it against the TS quest-hydrator output. -->
    <Compile Include="../../packages/unity/Runtime/Quest/InsimulQuestSystem.cs" />
    <Compile Include="../../packages/unity/Runtime/Quest/InsimulQuestRuntime.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/QuestSystemCorpus.cs" />
    <!-- Radiant slot-filling engine (US-UC4): engine-agnostic, UnityEngine-free.
         The deterministic generator (InsimulRadiantEngine) + the native-KB solver
         adapter (InsimulPrologRadiantSolver). The pure tests in Program.cs drive it
         with a stub solver; RunRadiantConformance drives it against the golden
         radiant corpus through the real InsimulProlog engine. -->
    <Compile Include="../../packages/unity/Runtime/Radiant/InsimulRadiantEngine.cs" />
    <Compile Include="../../packages/unity/Runtime/Radiant/InsimulPrologRadiantSolver.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/RadiantCorpus.cs" />
    <!-- Startup orchestrator (US-UC5): the UnityEngine-free full-loop context that
         ties the world source + save system + quest runtime together (Boot / new
         game / resume / commit / worldSnapshot-stability). The MonoBehaviour that
         drives it (templates/scripts/core/InsimulRuntimeBootstrap.cs) is UnityEngine-
         coupled and thus NOT included (structural gate only) — RunBootstrapTests in
         Program.cs proves this core end-to-end. -->
    <Compile Include="../../packages/unity/Runtime/InsimulRuntimeContext.cs" />
    <!-- The wrapper under test, referenced in place (no vendoring). -->
    <Compile Include="../../packages/unity/Runtime/Prolog/InsimulProlog.cs" />
    <Compile Include="../../packages/unity/Runtime/Prolog/NativeMethods.cs" />
    <!-- The game adapter (US-UP4): the real-engine backing the template shell
         delegates to. UnityEngine-free, so it compiles + runs here. -->
    <Compile Include="../../packages/unity/Runtime/Prolog/PrologGameAdapter.cs" />
    <!-- Asset binding layer (US-UB1): the pure, UnityEngine-free archetype-key
         matcher + resolution core. The InsimulBindingTable ScriptableObject that
         authors it is UnityEngine-coupled and thus NOT included (structural gate
         only) — RunBindingResolverTests in Program.cs proves this core. -->
    <Compile Include="../../packages/unity/Runtime/Binding/ArchetypeKey.cs" />
    <Compile Include="../../packages/unity/Runtime/Binding/BindingModel.cs" />
    <Compile Include="../../packages/unity/Runtime/Binding/BindingResolver.cs" />
    <!-- Placeholder asset pack (US-UB2): the pure, UnityEngine-free recipe +
         Placeholder-tier BindingLayer. The editor generator that materializes its
         primitive prefabs (Editor/PlaceholderPackGenerator.cs) is UnityEngine-
         coupled and thus NOT included (structural gate only) — RunPlaceholderPackTests
         proves the coverage guarantee (every golden-world key resolves) over this. -->
    <Compile Include="../../packages/unity/Runtime/Binding/PlaceholderPack.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/PlaceholderPackCorpus.cs" />
    <!-- Editor-time scene generation (US-UB3): the pure placement core + the
         UnityEngine-free pipeline orchestration (ISceneBuilder/ScenePipeline +
         the RecordingSceneBuilder double). It parses the World IR through the
         JsonVal model (already compiled for the save system) and resolves
         bindings via the PlaceholderPack tier. The UnitySceneBuilder that
         materializes GameObjects + the InsimulEntityId MonoBehaviour are
         UnityEngine-coupled and thus NOT included (structural gate only) —
         RunSceneGenTests proves the math + determinism + pipeline order. -->
    <Compile Include="../../packages/unity/Runtime/Scene/SceneGenerator.cs" />
    <Compile Include="../../packages/unity/Runtime/Scene/ISceneBuilder.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/SceneGenCorpus.cs" />
    <!-- Re-import diff policy (US-UB4): the pure, UnityEngine-free reconciliation
         core (ReimportDiff classification + serialization) + the apply-orchestration
         seam (IReimportSceneMutator / ReimportReconciler + RecordingReimportMutator
         double). The UnityEngine-coupled applier that walks the live scene tree
         (Editor/InsimulReimport.cs) is structural-gate-only — RunReimportDiffTests
         proves the policy + golden-report parity + hand-edit invariants over this. -->
    <Compile Include="../../packages/unity/Runtime/Scene/ReimportDiff.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/ReimportCorpus.cs" />
    <!-- Binding Editor window logic (US-UB5): the pure, UnityEngine-free suggestion
         + taxonomy-grouping model (BindingEditorModel) and the portable binding-pack
         serializer (BindingPack, over the same JsonVal/CanonicalJson core as the save
         system). The EditorWindow that wires AssetDatabase + object pickers to these
         (Editor/InsimulBindingEditorWindow.cs) is UnityEngine-coupled and thus NOT
         included (structural gate only) — RunBindingEditorTests proves suggestion
         ranking, taxonomy status, and pack round-trip / golden byte-parity over this. -->
    <Compile Include="../../packages/unity/Runtime/Binding/BindingPack.cs" />
    <Compile Include="../../packages/unity/Runtime/Binding/BindingEditorModel.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/BindingEditorCorpus.cs" />
    <!-- Default-UI view-models (US-UU1): the pure, UnityEngine-free cores — the
         panel registry (default map / creator override / diagnostics), the
         weighted-phase loading-screen model, the notification queue, and the
         design-token set. The UGUI-coupled views + catalog/manager/theme
         ScriptableObjects (Runtime/UI/InsimulUI{Manager,Catalog,ThemeAsset}.cs,
         InsimulLoadingScreen.cs, InsimulNotificationCenter.cs) are structural-gate-
         only. RunUiRegistry/LoadingScreen/Notification/ThemeToken tests in
         Program.cs drive these against the shared corpus
         (packages/core/conformance/ui/*.json). -->
    <Compile Include="../../packages/unity/Runtime/UI/InsimulUIRegistry.cs" />
    <Compile Include="../../packages/unity/Runtime/UI/InsimulLoadingScreenModel.cs" />
    <Compile Include="../../packages/unity/Runtime/UI/InsimulNotifications.cs" />
    <Compile Include="../../packages/unity/Runtime/UI/InsimulUITheme.cs" />
    <!-- Quest journal / tracker / offer view-models (US-UU2): the pure,
         UnityEngine-free journal/tracker/offer model + the runtime-event feed that
         drives it off the KB-backed InsimulQuestRuntime signals (no polling). The
         UGUI views (Runtime/UI/InsimulQuest{Journal,Tracker,OfferPanel}.cs) are
         structural-gate-only. RunQuestJournal/QuestFeed tests in Program.cs drive
         these against the shared corpus (quest-journal-cases.json) + a live runtime. -->
    <Compile Include="../../packages/unity/Runtime/UI/InsimulQuestJournalModel.cs" />
    <Compile Include="../../packages/unity/Runtime/UI/InsimulQuestFeed.cs" />
    <!-- Trade view-model (US-UU3): the pure inventory / container-transfer /
         merchant model, backed EXCLUSIVELY by save.currentState (JsonVal). The UGUI
         views (Runtime/UI/InsimulInventoryPanel/ContainerPanel/MerchantPanel.cs) are
         structural-gate-only. RunTradeTests in Program.cs drives it against the shared
         corpus (trade-cases.json) + a save serialize/load round-trip. -->
    <Compile Include="../../packages/unity/Runtime/UI/InsimulTradeModel.cs" />
    <Compile Include="../../packages/unity/Tests/Editor/UiCorpus.cs" />
  </ItemGroup>

</Project>
